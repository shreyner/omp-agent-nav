{
  "name": "omp-agent-nav",
  "version": "0.3.1",
  "private": true,
  "description": "oh-my-pi (omp) extension: move an agent session between projects and git worktrees, and run subagents in another project via task.cwd.",
  "keywords": [
    "omp",
    "oh-my-pi",
    "extension",
    "worktree",
    "agent"
  ],
  "homepage": "https://github.com/shreyner/omp-agent-nav#readme",
  "bugs": "https://github.com/shreyner/omp-agent-nav/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyner/omp-agent-nav.git"
  },
  "license": "MIT",
  "author": "Aleksandr Shreyner",
  "type": "module",
  "main": "./src/index.ts",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test ./test",
    "check": "tsc -p . && bun build ./src/index.ts --target=bun --packages=external --outdir=dist && biome check --error-on-warnings .",
    "typecheck": "tsc -p .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "matrix": "bun bin/matrix.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.11.0 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
